---
const periods = [
  { key: 'hour', label: 'Hourly', note: 'per hour' },
  { key: 'day', label: 'Daily', note: 'per workday' },
  { key: 'week', label: 'Weekly', note: 'per week' },
  { key: 'month', label: 'Monthly', note: 'per month' },
  { key: 'year', label: 'Yearly', note: 'per year' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Convert an hourly, daily, weekly, monthly, or yearly salary." />
    <meta name="theme-color" content="#fbf6ed" />
    <title>Salary Converter</title>
  </head>
  <body>
    <main class="page-shell" id="content">
      <section class="converter" aria-labelledby="converter-title">
        <header class="converter-header">
          <p class="eyebrow"><span aria-hidden="true"></span> Salary mathematics</p>
          <h1 id="converter-title">Know what your time is worth.</h1>
          <p class="intro">Enter a number in any field. Every other rate updates instantly.</p>
        </header>

        <form class="salary-form" data-salary-form>
          <fieldset class="rate-fields">
            <legend>Pay rates</legend>
            <div class="rates-grid">
              {periods.map((period, index) => (
                <label class:list={['rate-field', { featured: period.key === 'hour' }]} for={period.key}>
                  <span class="field-label">{period.label}</span>
                  <span class="amount-wrap">
                    <span class="currency" aria-hidden="true">$</span>
                    <input
                      id={period.key}
                      name={period.key}
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      value={index === 0 ? '25' : ''}
                      data-period={period.key}
                      aria-describedby={`${period.key}-note`}
                    />
                  </span>
                  <span class="field-note" id={`${period.key}-note`}>{period.note}</span>
                  <span class="net-note" data-net={period.key} hidden></span>
                </label>
              ))}
            </div>
          </fieldset>

          <section class="assumptions" aria-labelledby="assumptions-title">
            <div class="assumptions-heading">
              <p class="section-kicker">Your work year</p>
              <h2 id="assumptions-title">Set your assumptions</h2>
            </div>
            <div class="assumption-fields">
              <label for="hours-per-week">
                <span>Hours per week</span>
                <input id="hours-per-week" name="hours-per-week" type="number" inputmode="decimal" min="0.1" step="0.5" value="40" data-setting="hours" />
              </label>
              <span class="multiply" aria-hidden="true">x</span>
              <label for="weeks-per-year">
                <span>Weeks per year</span>
                <input id="weeks-per-year" name="weeks-per-year" type="number" inputmode="decimal" min="0.1" step="0.5" value="52" data-setting="weeks" />
              </label>
            </div>
            <p class="basis" data-basis>Based on 2,080 working hours per year</p>
          </section>

          <section class="tax-panel" aria-labelledby="tax-title">
            <details class="tax-disclosure">
              <summary>
                <span>
                  <span class="section-kicker">Optional estimate</span>
                  <strong id="tax-title">Include income tax</strong>
                </span>
                <span class="disclosure-icon" aria-hidden="true">+</span>
              </summary>
              <div class="tax-disclosure-content">
                <div class="tax-toggle">
                  <p>Estimate annual tax and deductions from your gross pay.</p>
                  <label class="check-label" for="include-tax">
                    <input id="include-tax" name="include-tax" type="checkbox" data-include-tax />
                    <span>Calculate</span>
                  </label>
                </div>
                <div class="tax-details" data-tax-details hidden>
              <p class="tax-description" data-tax-description>Income tax, CPP, EI, and long-term disability deductions are estimated from your annual gross pay.</p>
              <ul class="tax-list" data-tax-list>
                <li><label><input type="checkbox" checked data-tax-line="incomeTax" /><span>Federal + Ontario income tax <small>Calculated by default</small></span></label><strong data-income-tax>$0</strong></li>
                <li><label><input type="checkbox" checked data-tax-line="cpp" /><span>CPP contribution <small>Estimated from your pay stub</small></span></label><strong data-cpp>$0</strong></li>
                <li><label><input type="checkbox" checked data-tax-line="ei" /><span>EI premium <small>Estimated from your pay stub</small></span></label><strong data-ei>$0</strong></li>
                <li><label><input type="checkbox" checked data-tax-line="longTermDisability" /><span>Long-term disability <small>Estimated from your pay stub</small></span></label><strong data-ltd>$0</strong></li>
              </ul>
              <div class="custom-taxes" data-custom-taxes></div>
                  <button class="add-tax" type="button" data-add-tax>+ Add a tax row</button>
                </div>
              </div>
            </details>
            <div class="tax-breakdown" aria-live="polite">
              <span>Estimated annual take-home</span>
              <strong data-take-home>$0</strong>
              <small data-total-tax>$0 estimated tax and deductions</small>
            </div>
          </section>
        </form>

        <footer class="converter-footer">
          <p>Figures are gross pay estimates before taxes and deductions.</p>
          <button type="button" class="reset" data-reset>Reset values</button>
        </footer>
      </section>
    </main>

    <script>
      import { calculateTakeHomePay, isOntarioTimeZone } from '../lib/payroll.js';
      type Period = 'hour' | 'day' | 'week' | 'month' | 'year';

      const form = document.querySelector<HTMLFormElement>('[data-salary-form]');
      const basis = document.querySelector<HTMLElement>('[data-basis]');
      const reset = document.querySelector<HTMLButtonElement>('[data-reset]');
      const includeTax = document.querySelector<HTMLInputElement>('[data-include-tax]');
      const taxDetails = document.querySelector<HTMLElement>('[data-tax-details]');
      const taxDescription = document.querySelector<HTMLElement>('[data-tax-description]');
      const takeHome = document.querySelector<HTMLElement>('[data-take-home]');
      const totalTax = document.querySelector<HTMLElement>('[data-total-tax]');
      const addTax = document.querySelector<HTMLButtonElement>('[data-add-tax]');
      const customTaxes = document.querySelector<HTMLElement>('[data-custom-taxes]');
      const incomeTax = document.querySelector<HTMLElement>('[data-income-tax]');
      const cpp = document.querySelector<HTMLElement>('[data-cpp]');
      const ei = document.querySelector<HTMLElement>('[data-ei]');
      const ltd = document.querySelector<HTMLElement>('[data-ltd]');

      if (form && basis && reset) {
        const rateInputs = [...form.querySelectorAll<HTMLInputElement>('[data-period]')];
        const defaultTaxLines = [...form.querySelectorAll<HTMLInputElement>('[data-tax-line]')];
        const hoursInput = form.querySelector<HTMLInputElement>('[data-setting="hours"]');
        const weeksInput = form.querySelector<HTMLInputElement>('[data-setting="weeks"]');
        let activePeriod: Period = 'hour';

        const toNumber = (value: string): number => Number(value.replace(/[$,\s]/g, ''));
        const formatAmount = (value: number): string => new Intl.NumberFormat('en-US', { maximumFractionDigits: 2 }).format(value);
        const getAssumptions = (): { hours: number; weeks: number } => ({
          hours: Math.max(0.1, toNumber(hoursInput?.value ?? '40') || 40),
          weeks: Math.max(0.1, toNumber(weeksInput?.value ?? '52') || 52),
        });
        const getFactors = (): Record<Period, number> => {
          const { hours, weeks } = getAssumptions();
          const hoursPerYear = hours * weeks;
          return { hour: 1, day: hours / 5, week: hours, month: hoursPerYear / 12, year: hoursPerYear };
        };
        const updateBasis = (): void => {
          const { hours, weeks } = getAssumptions();
          basis.textContent = `Based on ${formatAmount(hours * weeks)} working hours per year`;
        };
        const formatCurrency = (value: number): string => new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 0 }).format(value);
        const formatNet = (value: number): string => new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: 2 }).format(value);
        const updateTaxEstimate = (): void => {
          if (!includeTax || !takeHome || !totalTax) return;
          const yearlyInput = rateInputs.find((input) => input.dataset.period === 'year');
          const gross = toNumber(yearlyInput?.value ?? '0');
          const customRates = [...(customTaxes?.querySelectorAll<HTMLInputElement>('[data-custom-tax-rate]') ?? [])].map((input) => {
            const enabled = input.closest<HTMLElement>('.extra-tax')?.querySelector<HTMLInputElement>('[data-custom-tax-enabled]')?.checked ?? true;
            return enabled ? toNumber(input.value) || 0 : 0;
          });
          const includedDeductions = Object.fromEntries(defaultTaxLines.map((input) => [input.dataset.taxLine, input.checked]));
          const estimate = calculateTakeHomePay(gross, customRates, includeTax.checked, includedDeductions);
          takeHome.textContent = formatCurrency(estimate.takeHome);
          totalTax.textContent = `${formatCurrency(estimate.totalTax)} estimated tax and deductions`;
          if (incomeTax) incomeTax.textContent = formatCurrency(estimate.federalTax + estimate.ontarioTax);
          if (cpp) cpp.textContent = formatCurrency(estimate.cpp);
          if (ei) ei.textContent = formatCurrency(estimate.ei);
          if (ltd) ltd.textContent = formatCurrency(estimate.longTermDisability);
          const factors = getFactors();
          form.querySelectorAll<HTMLElement>('[data-net]').forEach((note) => {
            const period = note.dataset.net as Period;
            note.hidden = !includeTax.checked;
            note.textContent = `${formatNet(estimate.takeHome * factors[period] / factors.year)} after tax and deductions`;
          });
        };
        const syncRates = (source: HTMLInputElement): void => {
          const sourcePeriod = source.dataset.period as Period | undefined;
          if (!sourcePeriod) return;
          const value = toNumber(source.value);
          if (!Number.isFinite(value) || value < 0) return;
          activePeriod = sourcePeriod;
          const factors = getFactors();
          const hourlyRate = value / factors[sourcePeriod];
          rateInputs.forEach((input) => {
            const period = input.dataset.period as Period | undefined;
            if (!period || input === source) return;
            input.value = formatAmount(hourlyRate * factors[period]);
          });
          updateBasis();
          updateTaxEstimate();
        };
        const syncFromActive = (): void => {
          const activeInput = rateInputs.find((input) => input.dataset.period === activePeriod);
          if (activeInput) syncRates(activeInput);
        };

        rateInputs.forEach((input) => {
          input.addEventListener('focus', () => { activePeriod = input.dataset.period as Period; });
          input.addEventListener('input', () => syncRates(input));
          input.addEventListener('blur', () => {
            const value = toNumber(input.value);
            if (Number.isFinite(value) && value >= 0) input.value = formatAmount(value);
          });
        });
        [hoursInput, weeksInput].forEach((input) => {
          input?.addEventListener('input', syncFromActive);
          input?.addEventListener('change', updateBasis);
        });
        includeTax?.addEventListener('change', () => {
          if (taxDetails) taxDetails.hidden = !includeTax.checked;
          updateTaxEstimate();
        });
        defaultTaxLines.forEach((input) => input.addEventListener('change', updateTaxEstimate));
        addTax?.addEventListener('click', () => {
          if (!customTaxes) return;
          const row = document.createElement('div');
          row.className = 'extra-tax';
          row.innerHTML = `<input type="checkbox" checked data-custom-tax-enabled aria-label="Include additional tax" /><div class="custom-tax-name"><input type="text" value="Additional tax" maxlength="50" data-custom-tax-description aria-label="Additional tax description" /><span>Custom rate</span></div><div class="percent-wrap"><input type="number" min="0" max="100" step="0.1" value="0" inputmode="decimal" data-custom-tax-rate aria-label="Additional tax rate" /><span aria-hidden="true">%</span></div><button type="button" class="remove-tax" aria-label="Remove additional tax row">Remove</button>`;
          const rate = row.querySelector<HTMLInputElement>('[data-custom-tax-rate]');
          const description = row.querySelector<HTMLInputElement>('[data-custom-tax-description]');
          const enabled = row.querySelector<HTMLInputElement>('[data-custom-tax-enabled]');
          const remove = row.querySelector<HTMLButtonElement>('.remove-tax');
          rate?.addEventListener('input', updateTaxEstimate);
          enabled?.addEventListener('change', updateTaxEstimate);
          remove?.addEventListener('click', () => { row.remove(); updateTaxEstimate(); });
          customTaxes.appendChild(row);
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            row.animate(
              [
                { opacity: 0, transform: 'translateY(-6px)' },
                { opacity: 1, transform: 'translateY(0)' },
              ],
              { duration: 180, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' },
            );
          }
          description?.focus();
          description?.select();
          updateTaxEstimate();
        });
        const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (includeTax && isOntarioTimeZone(timeZone)) {
          includeTax.checked = true;
          if (taxDetails) taxDetails.hidden = false;
          if (taxDescription) taxDescription.textContent = 'Ontario detected: your estimate includes income tax, CPP, EI, and long-term disability deductions.';
        }
        reset.addEventListener('click', () => {
          if (hoursInput) hoursInput.value = '40';
          if (weeksInput) weeksInput.value = '52';
          activePeriod = 'hour';
          const hourlyInput = rateInputs.find((input) => input.dataset.period === 'hour');
          if (hourlyInput) { hourlyInput.value = '25'; syncRates(hourlyInput); }
          if (includeTax) { includeTax.checked = false; if (taxDetails) taxDetails.hidden = true; }
          customTaxes?.replaceChildren();
          defaultTaxLines.forEach((input) => { input.checked = true; });
          updateTaxEstimate();
        });
        const hourlyInput = rateInputs.find((input) => input.dataset.period === 'hour');
        if (hourlyInput) syncRates(hourlyInput);
      }
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { color-scheme: light; }
  :global(body) { margin: 0; min-width: 320px; background: #fbf6ed; color: #292c2e; font-family: ui-rounded, "Avenir Next", Avenir, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; }
  :global(button), :global(input) { font: inherit; }
  :global(:focus-visible) { outline: 3px solid #e1644b; outline-offset: 3px; }
  .page-shell { min-height: 100dvb; display: grid; place-items: center; padding: 24px 16px; background: radial-gradient(circle at 10% 2%, #f3d7b4 0, transparent 33%), radial-gradient(circle at 100% 100%, #dce7d2 0, transparent 32%), #fbf6ed; }
  .converter { width: min(100%, 760px); overflow: hidden; border: 1px solid rgba(41, 44, 46, .15); border-radius: 22px; background: #fffdf8; box-shadow: 0 24px 60px rgba(72, 54, 31, .13), 0 2px 6px rgba(72, 54, 31, .06); }
  .converter-header { padding: 32px 24px 26px; }
  .eyebrow, .section-kicker { margin: 0; color: #ba503d; font-size: .69rem; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
  .eyebrow { display: flex; align-items: center; gap: 9px; }
  .eyebrow span { width: 22px; height: 1px; background: currentColor; }
  h1, h2, p { margin-top: 0; }
  h1 { max-width: 12ch; margin: 11px 0 12px; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.25rem, 9vw, 4rem); font-weight: 500; letter-spacing: -.055em; line-height: .98; text-wrap: balance; }
  .intro { max-width: 44ch; margin-bottom: 0; color: #676661; font-size: .98rem; line-height: 1.55; text-wrap: pretty; }
  .salary-form { border-block: 1px solid rgba(41, 44, 46, .13); }
  fieldset { min-inline-size: 0; margin: 0; padding: 22px 24px 24px; border: 0; }
  legend { padding: 0; color: #555752; font-size: .75rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .rates-grid { display: grid; gap: 10px; margin-top: 14px; }
  .rate-field { display: grid; grid-template-columns: minmax(92px, .7fr) minmax(0, 1fr); gap: 2px 12px; align-items: center; min-height: 68px; padding: 12px 14px; border: 1px solid #d9d5ce; border-radius: 11px; background: #fffcf6; transition: border-color 160ms ease, background-color 160ms ease; }
  .rate-field:focus-within { border-color: #e1644b; background: #fff9f4; }
  .rate-field.featured { border-color: #242928; background: #242928; color: #fffdf8; }
  .rate-field.featured:focus-within { border-color: #e1644b; }
  .field-label { grid-column: 1; font-size: .88rem; font-weight: 700; }
  .amount-wrap { grid-column: 2; display: flex; align-items: center; min-width: 0; }
  .currency { margin-right: 3px; color: #94928b; font-size: 1.1rem; }
  .featured .currency { color: #f0ba70; }
  .amount-wrap input { width: 100%; min-width: 0; padding: 3px 0; border: 0; outline: 0; background: transparent; color: inherit; font-size: 1.15rem; font-weight: 750; font-variant-numeric: tabular-nums; text-align: right; }
  .field-note { grid-column: 1 / -1; color: #85827b; font-size: .74rem; }
  .featured .field-note { color: #c8c9c0; }
  .net-note { grid-column: 1 / -1; color: #4d7057; font-size: .78rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .net-note[hidden] { display: none; }
  .featured .net-note { color: #f0ba70; }
  .assumptions { display: grid; gap: 20px; padding: 24px; background: #eff3e9; }
  .section-kicker { color: #4d7057; }
  h2 { margin: 5px 0 0; font-family: Georgia, "Times New Roman", serif; font-size: 1.65rem; font-weight: 500; letter-spacing: -.04em; }
  .assumption-fields { display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 10px; }
  .assumption-fields label { display: grid; gap: 6px; color: #4f554d; font-size: .75rem; font-weight: 700; }
  .assumption-fields input { width: 100%; min-height: 46px; border: 1px solid #bec9b8; border-radius: 8px; background: #fbfdf8; color: #292c2e; font-size: 1rem; font-weight: 700; font-variant-numeric: tabular-nums; padding: 8px 10px; }
  .multiply { padding-bottom: 13px; color: #789077; font-size: 1rem; }
  .basis { margin: -8px 0 0; color: #657465; font-size: .78rem; }
  .tax-panel { padding: 0; background: #fffaf1; border-top: 1px solid rgba(41, 44, 46, .1); }
  .tax-disclosure summary { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 88px; padding: 20px 24px; cursor: pointer; list-style: none; transition: background-color 160ms ease; }
  .tax-disclosure summary:hover { background: rgba(77, 112, 87, .05); }
  .tax-disclosure summary::-webkit-details-marker { display: none; }
  .tax-disclosure summary > span:first-child { display: grid; gap: 4px; }
  .tax-disclosure summary strong { font-family: Georgia, "Times New Roman", serif; font-size: 1.45rem; font-weight: 500; letter-spacing: -.04em; }
  .disclosure-icon { display: grid; place-items: center; flex: 0 0 auto; width: 30px; height: 30px; border: 1px solid #bec9b8; border-radius: 50%; color: #4d7057; font-size: 1.3rem; line-height: 1; transition: transform 160ms ease; }
  .tax-disclosure[open] .disclosure-icon { transform: rotate(45deg); }
  .tax-disclosure-content { padding: 0 24px 24px; }
  .tax-disclosure[open] .tax-disclosure-content { animation: tax-disclosure-enter 220ms cubic-bezier(.23, 1, .32, 1); }
  .tax-toggle { display: flex; align-items: center; justify-content: space-between; gap: 18px; }
  .tax-toggle > p { max-width: 31ch; margin: 0; color: #716f68; font-size: .81rem; line-height: 1.45; }
  .check-label { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: #4f554d; font-size: .8rem; font-weight: 750; cursor: pointer; transition: color 140ms ease; }
  .check-label:hover { color: #e1644b; }
  .check-label input { width: 18px; height: 18px; accent-color: #4d7057; }
  .tax-details { display: grid; gap: 14px; margin-top: 18px; }
  .tax-description { margin: 0; color: #716f68; font-size: .81rem; line-height: 1.45;}
  .tax-list { display: grid; gap: 1px; margin: 0; padding: 0; border: 1px solid #d9d5ce; border-radius: 9px; overflow: hidden; list-style: none; }
  .tax-list li { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 11px 13px; background: #fffdf8; color: #474a46; font-size: .8rem;}
  .tax-list li + li { border-top: 1px solid #e6e2da; }
  .tax-list span { display: grid; gap: 2px; }
  .tax-list label { display: flex; align-items: start; gap: 10px; cursor: pointer; }
  .tax-list input { width: 17px; height: 17px; margin: 2px 0 0; accent-color: #4d7057; }
  .tax-list small { color: #85827b; font-size: .69rem; }
  .tax-list strong { font-variant-numeric: tabular-nums; }
  .tax-breakdown { display: grid; gap: 2px; padding: 16px; border-radius: 9px; background: #242928; color: #f8f5ed; transition: transform 160ms cubic-bezier(.23, 1, .32, 1), box-shadow 160ms ease; }
  .tax-breakdown:hover { transform: translateY(-1px); box-shadow: 0 8px 18px rgba(36, 41, 40, .13); }
  .tax-panel > .tax-breakdown { margin: 0 24px 24px; }
  .tax-breakdown span { color: #d9ded3; font-size: .72rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; }
  .tax-breakdown strong { font-size: 1.65rem; font-variant-numeric: tabular-nums; letter-spacing: -.04em; }
  .tax-breakdown small { color: #c3c8bd; font-size: .76rem; }
  .custom-taxes { display: grid; gap: 10px; }
  .custom-taxes :global(.extra-tax) { display: grid; grid-template-columns: auto minmax(0, 1fr) 88px auto; align-items: center; gap: 12px; padding: 11px 13px; border: 1px solid #d9d5ce; border-radius: 9px; background: #fffdf8; color: #474a46; }
  .custom-taxes :global(.extra-tax > input[type="checkbox"]) { width: 17px; height: 17px; margin: 0; accent-color: #4d7057; }
  .custom-taxes :global(.custom-tax-name) { display: grid; gap: 2px; min-width: 0; }
  .custom-taxes :global(.custom-tax-name input) { width: 100%; min-width: 0; padding: 0; border: 0; outline: 0; background: transparent; color: inherit; font-size: .8rem; font-weight: 700; }
  .custom-taxes :global(.custom-tax-name input::placeholder) { color: #85827b; }
  .custom-taxes :global(.custom-tax-name span) { color: #85827b; font-size: .69rem; font-weight: 500; }
  .custom-taxes :global(.percent-wrap) { display: flex; align-items: center; min-width: 0; border-bottom: 1px solid #849082; }
  .custom-taxes :global(.percent-wrap input) { width: 100%; min-width: 0; min-height: 34px; border: 0; outline: 0; background: transparent; color: #292c2e; font-size: .95rem; font-weight: 700; text-align: right; }
  .custom-taxes :global(.percent-wrap span) { color: #657465; padding-left: 3px; }
  .custom-taxes :global(.remove-tax) { min-height: 34px; padding: 0; border: 0; background: transparent; color: #a44b3b; font-size: .72rem; font-weight: 750; cursor: pointer; }
  .add-tax { justify-self: start; min-height: 40px; padding: 0; border: 0; background: transparent; color: #4c6854; font-size: .8rem; font-weight: 750; cursor: pointer; transition: color 140ms ease, transform 120ms ease; }
  .add-tax:hover { color: #e1644b; }
  .add-tax:active { transform: scale(.97); }
  .converter-footer { display: flex; flex-direction: column; gap: 13px; padding: 19px 24px 22px; color: #77746d; font-size: .76rem; line-height: 1.5; }
  .converter-footer p { margin: 0; }
